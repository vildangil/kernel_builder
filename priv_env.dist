#!/bin/bash
# Local configuration template for Samsung Galaxy A03 Core (m168/sp9863a).
# Copy this file to priv_env and adjust Telegram values if you want notifications.

# Telegram bot (optional for local builds)
export BOT_TOKEN=""
export CHAT_ID=""

# Kernel checkout directory used by run_a3core.sh
export KDIR="kernel"

# Kernel source
export kernel_repo="https://github.com/vildangil/android_kernel_m168"
export kernel_branch="4.14.199-erofs"

# Build profile
export DEFCONFIG="a3core_eur_open_defconfig"
export COMPILERS="A03-Clang"
export BUILD_FILESYSTEM="EROFS"       # EROFS or EXT4
export ROOT_SOLUTION="ReSukiSU"       # ReSukiSU or KernelSU-Next
export CM4_WATCHDOG_OFF="true"         # true/false diagnostic PM_SYS watchdog command
export PERMISSIVE="false"              # true/false

# AnyKernel3
export zipper_repo="https://github.com/osm0sis/AnyKernel3"
export zipper_branch="master"

# Optional output suffix and notes
export SUFFIX=""
export NOTE=""

# Uncomment for extra Telegram messages in local scripts
# export VERBOSE=yes
