# Copy this file to priv_env (or <name>priv_env when using wrapper.sh <name>)
# and replace the placeholders below.

# Telegram bot token used by tg_utils.sh
export BOT_TOKEN="PUT_YOUR_BOT_TOKEN_HERE"

# Telegram chat/group ID
export CHAT_ID="PUT_YOUR_CHAT_ID_HERE"

# Local kernel checkout directory, relative or absolute
export KDIR="kernel-a3core"

# Samsung Galaxy A03 Core / m168 kernel source
export kernel_repo="https://github.com/vildangil/android_kernel_m168"
export kernel_branch="4.14.199-erofs"

# Compiler profile from ./toolchains, without .sh
export COMPILERS="A03-Clang"

# A03 Core build options
export BUILD_FILESYSTEM="EROFS"       # EROFS or EXT4
export ROOT_SOLUTION="ReSukiSU"       # ReSukiSU or KernelSU-Next
export CM4_WATCHDOG_OFF="true"         # diagnostic PM_SYS watchdog rstoff
export PERMISSIVE="false"              # true to apply KernelSU-permissive SELinux files
export DEFCONFIG="a3core_eur_open_defconfig"

# AnyKernel3 output
export zipper_repo="https://github.com/osm0sis/AnyKernel3"
export zipper_branch="master"
export SUFFIX=""

# Optional message sent by wrapper.sh
export NOTE=""

# Uncomment for extra host/repository messages
# export VERBOSE=yes
