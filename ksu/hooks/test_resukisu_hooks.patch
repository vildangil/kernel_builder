diff --git a/KernelSU/kernel/feature/sucompat.c b/KernelSU/kernel/feature/sucompat.c
--- a/KernelSU/kernel/feature/sucompat.c
+++ b/KernelSU/kernel/feature/sucompat.c
@@ -681,6 +681,81 @@
     return 0;
 }
 #endif // #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+
+#ifdef CONFIG_KSU_SUSFS
+/*
+ * Android 4.14 syscall layer uses userspace filename pointers in faccessat
+ * and stat-family syscalls, while current ReSukiSU SUSFS handlers accept
+ * struct filename **. Keep the upstream handlers intact and bridge 4.14 here.
+ */
+int ksu_handle_faccessat_user(int *dfd, const char __user **filename_user,
+			      int *mode, int *__unused_flags)
+{
+	char path[sizeof(su_path) + 1] = { 0 };
+	const struct cred *old_cred;
+
+	if (ksu_is_current_proc_unprivillege())
+		return 0;
+
+	if (!static_branch_unlikely(&ksu_su_compat_enabled))
+		return 0;
+
+	if (!filename_user || !*filename_user)
+		return 0;
+
+	if (!ksu_is_allow_uid_for_current(ksu_get_uid_t(current_uid())))
+		return 0;
+
+	ksu_strncpy_from_user_nofault(path, *filename_user, sizeof(path));
+
+	if (unlikely(!memcmp(path, su_path, sizeof(su_path)))) {
+		old_cred = override_creds(ksu_cred);
+		if (is_ksud_exists()) {
+			pr_info("ksu_handle_faccessat_user su->sh!\n");
+			*filename_user = sh_user_path();
+		} else {
+			pr_info("no ksud found, don't process faccessat for su!\n");
+		}
+		revert_creds(old_cred);
+	}
+
+	return 0;
+}
+
+int ksu_handle_stat_user(int *dfd, const char __user **filename_user,
+			 int *flags)
+{
+	char path[sizeof(su_path) + 1] = { 0 };
+	const struct cred *old_cred;
+
+	if (ksu_is_current_proc_unprivillege())
+		return 0;
+
+	if (!static_branch_unlikely(&ksu_su_compat_enabled))
+		return 0;
+
+	if (!filename_user || !*filename_user)
+		return 0;
+
+	if (!ksu_is_allow_uid_for_current(ksu_get_uid_t(current_uid())))
+		return 0;
+
+	ksu_strncpy_from_user_nofault(path, *filename_user, sizeof(path));
+
+	if (unlikely(!memcmp(path, su_path, sizeof(su_path)))) {
+		old_cred = override_creds(ksu_cred);
+		if (is_ksud_exists()) {
+			pr_info("ksu_handle_stat_user su->sh!\n");
+			*filename_user = sh_user_path();
+		} else {
+			pr_info("no ksud found, don't process stat for su!\n");
+		}
+		revert_creds(old_cred);
+	}
+
+	return 0;
+}
+#endif
 
