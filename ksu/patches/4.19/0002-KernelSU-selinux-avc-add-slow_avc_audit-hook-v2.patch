From 4122ab43a87d7f922081c9a2950e8c4f9e3f2990 Mon Sep 17 00:00:00 2001
From: backslashxx <118538522+backslashxx@users.noreply.github.com>
Date: Mon, 9 Mar 2026 23:47:06 +0100
Subject: [PATCH] KernelSU, selinux/avc: add slow_avc_audit hook v2

Signed-off-by: zyexro <zyexro@proton.me>
---
 arch/arm64/configs/blossom_defconfig | 1 +
 security/selinux/avc.c               | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/arch/arm64/configs/blossom_defconfig b/arch/arm64/configs/blossom_defconfig
index 6cfdce98a85a..045f230b455b 100644
--- a/arch/arm64/configs/blossom_defconfig
+++ b/arch/arm64/configs/blossom_defconfig
@@ -1,6 +1,7 @@
 CONFIG_LOCALVERSION="-sashimi"
 # CONFIG_LOCALVERSION_AUTO is not set
 CONFIG_PREEMPT=y
+CONFIG_KSU_EXTRAS=y
 # CONFIG_CPU_ISOLATION is not set
 CONFIG_LOG_BUF_SHIFT=21
 CONFIG_PELT_UTIL_HALFLIFE_16=y
diff --git a/security/selinux/avc.c b/security/selinux/avc.c
index b7c17932f03b..667174f0d5de 100644
--- a/security/selinux/avc.c
+++ b/security/selinux/avc.c
@@ -761,6 +761,10 @@ static void avc_audit_post_callback(struct audit_buffer *ab, void *a)
 	}
 }
 
+#ifdef CONFIG_KSU
+extern int ksu_handle_slow_avc_audit_new(u32 tsid, u16 *tclass);
+#endif
+
 /* This is the slow part of avc audit with big stack footprint */
 noinline int slow_avc_audit(struct selinux_state *state,
 			    u32 ssid, u32 tsid, u16 tclass,
@@ -776,6 +780,11 @@ noinline int slow_avc_audit(struct selinux_state *state,
 	if (!denied)
 		return 0;
 
+#ifdef CONFIG_KSU
+	ksu_handle_slow_avc_audit_new(tsid, &tclass);
+	if (!tclass)
+		return 0;
+#endif
 	if (!a) {
 		a = &stack_data;
 		a->type = LSM_AUDIT_DATA_NONE;
-- 
2.53.0

