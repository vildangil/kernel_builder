#!/bin/bash
# A03 Core / m168 builder environment

export maindir="$(pwd)"
export outside="${maindir}/.."

export ARCH="arm64"
export SUBARCH="arm64"
export KBUILD_BUILD_USER="VildanG"
export KBUILD_BUILD_HOST="telegram-a3core"

export defconfig="${DEFCONFIG:-a3core_eur_open_defconfig}"
export BUILD_FILESYSTEM="${BUILD_FILESYSTEM:-EROFS}"
export ROOT_SOLUTION="${ROOT_SOLUTION:-ReSukiSU}"

if [[ -z "$zipper_repo" ]]; then
  export zipper_repo="https://github.com/osm0sis/AnyKernel3"
fi
if [[ -z "$zipper_branch" ]]; then
  export zipper_branch="master"
fi

export out_image="${maindir}/out/arch/${ARCH}/boot/Image"
export out_dtb=""
export out_dtbo=""
export zipper="${outside}/zipper-a3core"

export defconfig_file="${maindir}/arch/${ARCH}/configs/${defconfig}"
export kernel_head="$(git log --pretty=format:'%h' -1)"
export kernel_ver="$(make kernelversion)"
export kernel_name="A03-Core-${BUILD_FILESYSTEM}-${ROOT_SOLUTION}"
export TIME="$(date +'%y%m%d-%H%M')"

export zip_name="${maindir}/${kernel_name}${SUFFIX}-${TIME}-${kernel_head}.zip"
